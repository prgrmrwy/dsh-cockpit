#!/usr/bin/env node
import { spawn } from 'node:child_process'
import { closeSync, existsSync, openSync, realpathSync, statSync } from 'node:fs'
import { mkdir, readdir, readFile, rm, stat, symlink } from 'node:fs/promises'
import { createConnection } from 'node:net'
import os from 'node:os'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { parseArgs } from 'node:util'

const CLI_FILE = fileURLToPath(import.meta.url)
export const REPO_ROOT = path.resolve(path.dirname(CLI_FILE), '..')
const ACTIONS = new Set(['start', 'build', 'stop', 'restart', 'bootstrap', 'install', 'uninstall', 'status'])

export function parseCliArgs(args) {
  const parsed = parseArgs({
    args,
    allowPositionals: true,
    strict: true,
    options: {
      foreground: { type: 'boolean' },
      'no-open': { type: 'boolean' },
      dev: { type: 'boolean' },
      build: { type: 'boolean', short: 'b' },
      force: { type: 'boolean' },
      help: { type: 'boolean', short: 'h' },
    },
  })
  if (parsed.positionals.length > 1) throw new Error(`unexpected argument: ${parsed.positionals.slice(1).join(' ')}`)
  const action = parsed.positionals[0] ?? 'start'
  if (!ACTIONS.has(action)) throw new Error(`unknown command: ${action}`)
  return {
    action,
    foreground: parsed.values.foreground ?? false,
    noOpen: parsed.values['no-open'] ?? false,
    dev: parsed.values.dev ?? false,
    build: parsed.values.build ?? false,
    force: parsed.values.force ?? false,
    help: parsed.values.help ?? false,
  }
}

export function validateNodeVersion(version = process.versions.node) {
  const major = Number(version.split('.')[0])
  if (!Number.isInteger(major) || major < 22) throw new Error(`Node.js ${version} is unsupported; Node.js >= 22 is required`)
  return version
}

export function resolveCliHome(env = process.env, homedir = os.homedir) {
  const configured = env.DSH_COCKPIT_HOME
  return configured !== undefined && configured.trim() !== ''
    ? path.resolve(configured)
    : path.join(homedir(), '.dsh-cockpit')
}

export function resolveCliPort(env = process.env) {
  const configured = env.COCKPIT_PORT
  if (configured === undefined || configured.trim() === '') return 3090
  if (!/^\d+$/.test(configured.trim())) throw new Error(`invalid COCKPIT_PORT: ${configured}`)
  const port = Number(configured)
  if (!Number.isSafeInteger(port) || port < 1 || port > 65_535) throw new Error(`invalid COCKPIT_PORT: ${configured}`)
  return port
}

function environmentPath(env) {
  return env.PATH ?? env.Path ?? env.path ?? ''
}

function executableExtensions(platform, env, command) {
  if (platform !== 'win32' || path.win32.extname(command) !== '') return ['']
  const pathext = env.PATHEXT ?? env.PathExt ?? '.COM;.EXE;.BAT;.CMD'
  return pathext.split(';').filter(Boolean).map(value => value.toLowerCase())
}

function isExecutable(file, platform) {
  try {
    if (!statSync(file).isFile()) return false
    if (platform !== 'win32') {
      const mode = statSync(file).mode
      return (mode & 0o111) !== 0
    }
    return true
  } catch {
    return false
  }
}

export function findExecutable(command, { env = process.env, platform = process.platform } = {}) {
  if (typeof command !== 'string' || command.trim() === '' || /[\0\r\n]/.test(command)) return undefined
  const pathApi = platform === 'win32' ? path.win32 : path.posix
  const pathLike = pathApi.isAbsolute(command) || command.includes('/') || command.includes('\\')
  const directories = pathLike
    ? ['']
    : environmentPath(env).split(platform === 'win32' ? ';' : ':').map(value => value.replace(/^"|"$/g, '')).filter(Boolean)
  for (const directory of directories) {
    const base = pathLike ? command : pathApi.join(directory, command)
    for (const extension of executableExtensions(platform, env, command)) {
      const candidate = `${base}${extension}`
      if (isExecutable(candidate, platform)) return pathApi.resolve(candidate)
      if (platform === 'win32' && extension !== '' && isExecutable(`${base}${extension.toUpperCase()}`, platform)) {
        return pathApi.resolve(`${base}${extension.toUpperCase()}`)
      }
    }
  }
  return undefined
}

export function resolvePnpmExecutable(env = process.env, platform = process.platform) {
  const configured = env.DSH_COCKPIT_PNPM_EXECUTABLE
  const requested = configured !== undefined && configured.trim() !== '' ? configured : 'pnpm'
  const resolved = findExecutable(requested, { env, platform })
  if (resolved === undefined) {
    throw new Error(`pnpm executable not found: ${requested} (set DSH_COCKPIT_PNPM_EXECUTABLE or update PATH)`)
  }
  return resolved
}

export function resolvePnpmCommand(env = process.env, platform = process.platform) {
  const configured = env.DSH_COCKPIT_PNPM_EXECUTABLE
  if (configured !== undefined && configured.trim() !== '') {
    return { executable: resolvePnpmExecutable(env, platform), prefixArgs: [] }
  }
  const corepack = findExecutable('corepack', { env, platform })
  if (corepack !== undefined) return { executable: corepack, prefixArgs: ['pnpm'] }
  return { executable: resolvePnpmExecutable(env, platform), prefixArgs: [] }
}

function quoteCmdToken(value) {
  if (/[\0\r\n]/.test(value)) throw new Error('Windows command shim arguments cannot contain line breaks')
  return `"${value.replaceAll('"', '""').replaceAll('%', '%%')}"`
}

export function buildCommandInvocation(executable, args, { env = process.env, platform = process.platform } = {}) {
  const extension = platform === 'win32' ? path.win32.extname(executable).toLowerCase() : path.extname(executable).toLowerCase()
  if (platform !== 'win32' || (extension !== '.cmd' && extension !== '.bat')) {
    return { executable, args: [...args], windowsVerbatimArguments: false }
  }
  const comspec = env.ComSpec ?? env.COMSPEC ?? findExecutable('cmd.exe', { env, platform })
  if (comspec === undefined || comspec.trim() === '') throw new Error('ComSpec is required to run a Windows command shim')
  const commandLine = [executable, ...args].map(quoteCmdToken).join(' ')
  return { executable: comspec, args: ['/d', '/s', '/c', `"${commandLine}"`], windowsVerbatimArguments: true }
}

function spawnCommand(executable, args, options = {}) {
  const invocation = buildCommandInvocation(executable, args, options)
  return spawn(invocation.executable, invocation.args, {
    cwd: options.cwd ?? REPO_ROOT,
    env: options.env ?? process.env,
    stdio: options.stdio ?? 'inherit',
    shell: false,
    windowsHide: options.windowsHide ?? true,
    windowsVerbatimArguments: invocation.windowsVerbatimArguments,
  })
}

function waitForExit(child) {
  return new Promise((resolve, reject) => {
    child.once('error', reject)
    child.once('exit', (code, signal) => resolve({ code, signal }))
  })
}

async function runCommand(executable, args, options = {}) {
  const outcome = await waitForExit(spawnCommand(executable, args, options))
  if (outcome.code !== 0) throw new Error(`${path.basename(executable)} exited with ${outcome.code ?? outcome.signal ?? 'unknown status'}`)
}

async function runPnpm(args, context, options = {}) {
  const command = resolvePnpmCommand(context.env, context.platform)
  await runCommand(command.executable, [...command.prefixArgs, ...args], {
    ...options, cwd: REPO_ROOT, env: context.env, platform: context.platform,
  })
}

async function newestMtime(directory) {
  let newest = 0
  for (const entry of await readdir(directory, { withFileTypes: true })) {
    const file = path.join(directory, entry.name)
    if (entry.isDirectory()) newest = Math.max(newest, await newestMtime(file))
    else if (entry.isFile()) newest = Math.max(newest, (await stat(file)).mtimeMs)
  }
  return newest
}

export async function needsBuild(repoRoot = REPO_ROOT) {
  const outputs = [
    path.join(repoRoot, 'packages/cockpit-server/dist/main.js'),
    path.join(repoRoot, 'packages/cockpit-web/dist/index.html'),
    path.join(repoRoot, 'packages/shared/dist/index.js'),
  ]
  if (outputs.some(output => !existsSync(output))) return true
  const oldestOutput = Math.min(...await Promise.all(outputs.map(async output => (await stat(output)).mtimeMs)))
  const sources = [
    path.join(repoRoot, 'packages/cockpit-server/src'),
    path.join(repoRoot, 'packages/cockpit-web/src'),
    path.join(repoRoot, 'packages/shared/src'),
  ]
  return Math.max(...await Promise.all(sources.map(newestMtime))) > oldestOutput
}

function isRuntimeRecord(value) {
  return typeof value === 'object' && value !== null
    && value.version === 1 && value.app === 'dsh-cockpit'
    && typeof value.instanceId === 'string' && value.instanceId !== ''
    && Number.isInteger(value.pid) && value.pid > 0
    && Number.isInteger(value.port) && value.port >= 1 && value.port <= 65_535
    && typeof value.repoRoot === 'string' && value.repoRoot !== ''
    && Number.isFinite(value.startedAt) && value.startedAt > 0
}

async function readRuntimeRecord(cockpitHome) {
  const file = path.join(cockpitHome, 'runtime.json')
  try {
    const parsed = JSON.parse(await readFile(file, 'utf8'))
    if (!isRuntimeRecord(parsed)) throw new Error('runtime record has invalid fields')
    return parsed
  } catch (error) {
    if (error?.code === 'ENOENT') return undefined
    throw new Error(`runtime record is corrupt: ${error instanceof Error ? error.message : String(error)}`, {
      cause: error,
    })
  }
}

async function readToken(cockpitHome) {
  try {
    const token = (await readFile(path.join(cockpitHome, 'token'), 'utf8')).trim()
    return token === '' ? undefined : token
  } catch (error) {
    if (error?.code === 'ENOENT') return undefined
    throw error
  }
}

function normalizedIdentity(value, platform = process.platform) {
  const normalized = path.resolve(value)
  return platform === 'win32' ? normalized.toLowerCase() : normalized
}

export function validateRuntimeStatus(record, status, repoRoot = REPO_ROOT, platform = process.platform) {
  return isRuntimeRecord(status)
    && status.instanceId === record.instanceId
    && status.pid === record.pid
    && status.port === record.port
    && normalizedIdentity(status.repoRoot, platform) === normalizedIdentity(repoRoot, platform)
}

async function fetchWithTimeout(url, init = {}, timeoutMs = 1500) {
  const controller = new AbortController()
  const timer = setTimeout(() => controller.abort(), timeoutMs)
  try {
    return await fetch(url, { ...init, signal: controller.signal })
  } finally {
    clearTimeout(timer)
  }
}

async function fetchRuntimeStatus(record, cockpitHome, repoRoot, platform) {
  const token = await readToken(cockpitHome)
  if (token === undefined) return undefined
  try {
    const response = await fetchWithTimeout(`http://127.0.0.1:${record.port}/api/runtime/status`, {
      headers: { Cookie: `cockpit_token=${token}` },
    })
    if (!response.ok) return undefined
    const status = await response.json()
    return validateRuntimeStatus(record, status, repoRoot, platform) ? status : undefined
  } catch {
    return undefined
  }
}

export function probePort(port, timeoutMs = 350) {
  return new Promise(resolve => {
    const socket = createConnection({ host: '127.0.0.1', port })
    let settled = false
    const finish = value => {
      if (settled) return
      settled = true
      socket.destroy()
      resolve(value)
    }
    socket.setTimeout(timeoutMs)
    socket.once('connect', () => finish(true))
    socket.once('timeout', () => finish(false))
    socket.once('error', () => finish(false))
  })
}

async function inspectRuntime(context) {
  let record
  try {
    record = await readRuntimeRecord(context.cockpitHome)
  } catch (error) {
    return { kind: 'corrupt', diagnostic: error.message }
  }
  if (record !== undefined) {
    const status = await fetchRuntimeStatus(record, context.cockpitHome, context.repoRoot, context.platform)
    if (status !== undefined) return { kind: 'running', record, status }
    if (await probePort(record.port)) return { kind: 'mismatch', record, diagnostic: `port ${record.port} did not return the expected authenticated runtime identity` }
    return { kind: 'stale', record, diagnostic: `runtime record ${record.instanceId.slice(0, 8)} has no listener on port ${record.port}` }
  }
  if (await probePort(context.port)) return { kind: 'unknown-listener', diagnostic: `port ${context.port} is occupied by an unknown process` }
  return { kind: 'stopped' }
}

async function waitForRunning(context, child, timeoutMs = 30_000) {
  const deadline = Date.now() + timeoutMs
  while (Date.now() < deadline) {
    const state = await inspectRuntime(context)
    if (state.kind === 'running') return state
    if (child?.exitCode !== null && child?.exitCode !== undefined) throw new Error(`cockpit server exited early with code ${child.exitCode}`)
    await new Promise(resolve => setTimeout(resolve, 250))
  }
  throw new Error(`cockpit did not become ready on port ${context.port} within ${Math.round(timeoutMs / 1000)}s`)
}

async function waitForPortRelease(port, timeoutMs = 15_000) {
  const deadline = Date.now() + timeoutMs
  while (Date.now() < deadline) {
    if (!await probePort(port)) return true
    await new Promise(resolve => setTimeout(resolve, 200))
  }
  return false
}

function captureInteractiveSignals(child, platform, confirmBatchTermination = false) {
  const state = { signal: undefined }
  const handle = signal => {
    state.signal ??= signal
    if (platform === 'win32' && confirmBatchTermination) child.stdin?.write('Y\r\n')
    if (platform !== 'win32' && child.exitCode === null && child.signalCode === null) {
      try {
        child.kill(signal)
      } catch {
        // The child may have exited between the state check and kill().
      }
    }
  }
  const onSigint = () => handle('SIGINT')
  const onSigterm = () => handle('SIGTERM')
  process.on('SIGINT', onSigint)
  process.on('SIGTERM', onSigterm)
  return {
    state,
    dispose() {
      process.off('SIGINT', onSigint)
      process.off('SIGTERM', onSigterm)
    },
  }
}

async function removeExitedRuntime(context, instanceId) {
  if (instanceId === undefined) return
  let record
  try {
    record = await readRuntimeRecord(context.cockpitHome)
  } catch {
    return
  }
  if (record?.instanceId !== instanceId || await probePort(record.port)) return
  await rm(path.join(context.cockpitHome, 'runtime.json'), { force: true })
}

function openBrowser(url, context) {
  const command = context.platform === 'win32' ? 'explorer.exe' : context.platform === 'darwin' ? 'open' : 'xdg-open'
  const windowsExplorer = context.platform === 'win32'
    ? path.join(context.env.SystemRoot ?? context.env.SYSTEMROOT ?? 'C:\\Windows', 'explorer.exe')
    : undefined
  const executable = windowsExplorer !== undefined && existsSync(windowsExplorer)
    ? windowsExplorer
    : findExecutable(command, { env: context.env, platform: context.platform })
  if (executable === undefined) {
    process.stdout.write(`cockpit started — open ${url}\n`)
    return
  }
  const child = spawn(executable, [url], { detached: true, stdio: 'ignore', shell: false, windowsHide: true })
  child.once('error', () => {})
  child.unref()
  process.stdout.write(`UI: ${url}\n`)
}

async function build(context) {
  process.stdout.write('build: pnpm -r build ...\n')
  await runPnpm(['-r', 'build'], context)
  process.stdout.write('build complete\n')
}

async function bootstrapDependencies(options, context) {
  await mkdir(context.cockpitHome, { recursive: true })
  process.stdout.write(`bootstrap: pnpm install${options.force ? ' --force' : ''} ...\n`)
  await runPnpm(['install', ...(options.force ? ['--force'] : [])], context)
  process.stdout.write('bootstrap complete\n')
}

async function startForeground(options, context) {
  const serverEntry = path.join(context.repoRoot, 'packages/cockpit-server/dist/main.js')
  const child = spawn(process.execPath, [serverEntry], {
    cwd: context.repoRoot,
    env: context.env,
    stdio: 'inherit',
    shell: false,
    windowsHide: true,
  })
  const signals = captureInteractiveSignals(child, context.platform)
  const exit = waitForExit(child)
  let running
  let outcome
  try {
    running = await waitForRunning(context, child)
    const url = `http://127.0.0.1:${running.record.port}`
    if (!options.noOpen) openBrowser(url, context)
    process.stdout.write(`cockpit started in foreground: ${url}\n`)
    outcome = await exit
  } catch (error) {
    if (signals.state.signal === undefined) throw error
    outcome = await exit
  } finally {
    signals.dispose()
    await removeExitedRuntime(context, running?.record.instanceId)
  }
  if (signals.state.signal !== undefined) return
  if (outcome.code !== 0 && outcome.signal === null) throw new Error(`cockpit server exited with code ${outcome.code}`)
}

async function startBackground(options, context) {
  await mkdir(context.cockpitHome, { recursive: true })
  const logFile = path.join(context.cockpitHome, 'cockpit.log')
  const descriptor = openSync(logFile, 'a')
  let child
  let exit
  try {
    child = spawn(process.execPath, [path.join(context.repoRoot, 'packages/cockpit-server/dist/main.js')], {
      cwd: context.repoRoot,
      env: context.env,
      detached: true,
      windowsHide: true,
      shell: false,
      stdio: ['ignore', descriptor, descriptor],
    })
    exit = waitForExit(child)
    void exit.catch(() => {})
    child.unref()
  } finally {
    closeSync(descriptor)
  }
  let running
  try {
    running = await waitForRunning(context, child)
  } catch (error) {
    if (child.exitCode === null && child.signalCode === null) child.kill('SIGTERM')
    await Promise.race([
      exit.catch(() => undefined),
      new Promise(resolve => setTimeout(resolve, 1000)),
    ])
    throw error
  }
  const url = `http://127.0.0.1:${running.record.port}`
  if (!options.noOpen) openBrowser(url, context)
  process.stdout.write(`cockpit started: ${url} (PID ${running.record.pid}, log ${logFile})\n`)
}

async function start(options, context) {
  const current = await inspectRuntime(context)
  if (current.kind === 'running') {
    const url = `http://127.0.0.1:${current.record.port}`
    if (!options.noOpen) openBrowser(url, context)
    process.stdout.write(`cockpit is already running: ${url}\n`)
    return
  }
  if (current.kind === 'mismatch' || current.kind === 'unknown-listener' || current.kind === 'corrupt') {
    throw new Error(current.diagnostic)
  }
  if (current.kind === 'stale') {
    if (current.record.port !== context.port && await probePort(context.port)) {
      throw new Error(`port ${context.port} is occupied by an unknown process`)
    }
    process.stderr.write(`warning: ${current.diagnostic}; the new instance will replace it\n`)
  }
  if (options.build || await needsBuild(context.repoRoot)) await build(context)
  if (options.foreground) await startForeground(options, context)
  else await startBackground(options, context)
}

async function stop(context) {
  const current = await inspectRuntime(context)
  if (current.kind === 'stopped') {
    process.stdout.write(`no cockpit server found (port ${context.port})\n`)
    return
  }
  if (current.kind !== 'running') throw new Error(current.diagnostic)
  const token = await readToken(context.cockpitHome)
  if (token === undefined) throw new Error('cockpit token is unavailable; refusing to stop an unverified process')
  const response = await fetchWithTimeout(`http://127.0.0.1:${current.record.port}/api/runtime/shutdown`, {
    method: 'POST',
    headers: {
      Cookie: `cockpit_token=${token}`,
      'X-Cockpit-Instance': current.record.instanceId,
    },
  }, 3_000)
  if (!response.ok) throw new Error(`cockpit refused shutdown with HTTP ${response.status}`)
  if (!await waitForPortRelease(current.record.port)) throw new Error(`cockpit did not release port ${current.record.port}`)
  process.stdout.write(`cockpit stopped (port ${current.record.port})\n`)
}

async function status(context) {
  const current = await inspectRuntime(context)
  if (current.kind === 'running') {
    process.stdout.write([
      'cockpit is running:',
      `  URL:      http://127.0.0.1:${current.record.port}`,
      `  PID:      ${current.record.pid}`,
      `  instance: ${current.record.instanceId.slice(0, 8)}`,
      `  data:     ${context.cockpitHome}`,
      `  log:      ${path.join(context.cockpitHome, 'cockpit.log')}`,
      '',
    ].join('\n'))
    return
  }
  if (current.kind === 'stopped') {
    process.stdout.write(`cockpit is not running (port ${context.port})\n  data: ${context.cockpitHome}\n`)
    return
  }
  process.stdout.write(`cockpit state: ${current.kind}\n  ${current.diagnostic}\n  data: ${context.cockpitHome}\n`)
}

async function runDevelopment(context) {
  const current = await inspectRuntime(context)
  if (current.kind === 'running') {
    throw new Error(`cockpit is already running on port ${current.record.port}; stop it before starting development mode`)
  }
  if (current.kind === 'mismatch' || current.kind === 'unknown-listener' || current.kind === 'corrupt') {
    throw new Error(current.diagnostic)
  }
  if (current.kind === 'stale') process.stderr.write(`warning: ${current.diagnostic}; development mode will replace it\n`)
  const pnpm = resolvePnpmCommand(context.env, context.platform)
  const extension = context.platform === 'win32' ? path.win32.extname(pnpm.executable).toLowerCase() : ''
  const usesWindowsBatchShim = extension === '.cmd' || extension === '.bat'
  process.stdout.write('dev: server watch + Vite (Ctrl+C to stop)\nUI: http://127.0.0.1:5173\n')
  const child = spawnCommand(pnpm.executable, [...pnpm.prefixArgs, '-r', '--parallel', 'dev'], {
    cwd: context.repoRoot,
    env: context.env,
    platform: context.platform,
    stdio: usesWindowsBatchShim ? ['pipe', 'inherit', 'inherit'] : 'inherit',
    windowsHide: false,
  })
  const signals = captureInteractiveSignals(child, context.platform, usesWindowsBatchShim)
  const exit = waitForExit(child)
  let running
  let outcome
  try {
    running = await waitForRunning(context, child)
    outcome = await exit
  } catch (error) {
    if (signals.state.signal === undefined) throw error
    outcome = await exit
  } finally {
    signals.dispose()
    await removeExitedRuntime(context, running?.record.instanceId)
  }
  if (signals.state.signal !== undefined) return
  if (outcome.code !== 0 && outcome.signal === null) throw new Error(`development processes exited with code ${outcome.code}`)
}

async function installCommand(context) {
  if (context.platform === 'win32') {
    await runPnpm(['link', '--global'], context)
    process.stdout.write('cockpit command installed through pnpm global bin\n')
    return
  }
  const binDir = context.env.COCKPIT_BIN_DIR?.trim() || path.join(os.homedir(), '.local', 'bin')
  const link = path.join(binDir, 'cockpit')
  await mkdir(binDir, { recursive: true })
  await rm(link, { force: true })
  await symlink(path.relative(binDir, CLI_FILE), link)
  process.stdout.write(`cockpit command installed: ${link}\n`)
}

async function uninstallCommand(context) {
  if (context.platform === 'win32') {
    await runPnpm(['unlink', '--global', 'dsh-cockpit'], context)
    process.stdout.write('cockpit command removed from pnpm global bin\n')
    return
  }
  const binDir = context.env.COCKPIT_BIN_DIR?.trim() || path.join(os.homedir(), '.local', 'bin')
  const link = path.join(binDir, 'cockpit')
  await rm(link, { force: true })
  process.stdout.write(`cockpit command removed: ${link}\n`)
}

function usage() {
  return `dsh-cockpit cross-platform launcher\n\nUsage:\n  cockpit [start] [--foreground] [--no-open] [--dev] [-b|--build]\n  cockpit bootstrap [--force]\n  cockpit build|stop|restart|status|install|uninstall\n\nWindows without a global shim:\n  node .\\bin\\cockpit start\n\nEnvironment:\n  DSH_COCKPIT_HOME             data and log directory\n  DSH_COCKPIT_PNPM_EXECUTABLE  pnpm executable override\n  DSH_COCKPIT_SSH_EXECUTABLE   OpenSSH executable override (used by server)\n  COCKPIT_PORT                 server port (default 3090)\n  COCKPIT_BIN_DIR              Unix command installation directory\n`
}

export async function main(args = process.argv.slice(2), overrides = {}) {
  validateNodeVersion(overrides.nodeVersion ?? process.versions.node)
  let options
  try {
    options = parseCliArgs(args)
  } catch (error) {
    throw new Error(`${error instanceof Error ? error.message : String(error)}\n\n${usage()}`, {
      cause: error,
    })
  }
  if (options.help) {
    process.stdout.write(usage())
    return
  }
  const env = overrides.env ?? process.env
  const context = {
    env,
    platform: overrides.platform ?? process.platform,
    repoRoot: overrides.repoRoot ?? REPO_ROOT,
    cockpitHome: resolveCliHome(env),
    port: resolveCliPort(env),
  }
  if (options.action === 'bootstrap') return bootstrapDependencies(options, context)
  if (options.action === 'build') return build(context)
  if (options.action === 'stop') return stop(context)
  if (options.action === 'status') return status(context)
  if (options.action === 'install') return installCommand(context)
  if (options.action === 'uninstall') return uninstallCommand(context)
  if (options.action === 'restart') {
    await stop(context)
    return start(options, context)
  }
  if (options.dev) return runDevelopment(context)
  return start(options, context)
}

function invokedDirectly() {
  if (process.argv[1] === undefined) return false
  try {
    return realpathSync(process.argv[1]) === realpathSync(CLI_FILE)
  } catch {
    return path.resolve(process.argv[1]) === path.resolve(CLI_FILE)
  }
}

if (invokedDirectly()) {
  main().catch(error => {
    process.stderr.write(`error: ${error instanceof Error ? error.message : String(error)}\n`)
    process.exitCode = 1
  })
}
