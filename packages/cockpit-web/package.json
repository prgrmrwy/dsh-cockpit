{
  "name": "@dsh-cockpit/web",
  "version": "0.1.0",
  "private": true,
  "description": "Cockpit shell UI: top bar, panels, workbench iframe",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
