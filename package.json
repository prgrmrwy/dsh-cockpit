{
  "name": "dsh-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-device cockpit for DeepSeek Harness: manage devices, aggregate status, and open each device's own DSH workbench",
  "license": "MIT",
  "author": "prgrmrwy",
  "homepage": "https://github.com/prgrmrwy/dsh-cockpit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prgrmrwy/dsh-cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/prgrmrwy/dsh-cockpit/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ai-agent",
    "multi-device",
    "cockpit",
    "ssh-tunnel",
    "pwa"
  ],
  "type": "module",
  "bin": {
    "cockpit": "bin/cockpit"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "node --test tests/*.test.mjs && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint bin/cockpit tests/*.mjs scripts/acceptance/*.mjs && pnpm -r lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
