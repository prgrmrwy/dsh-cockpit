{
  "name": "dsh-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-device cockpit for DeepSeek Harness: manage devices, aggregate status, and open each device's own DSH workbench",
  "type": "module",
  "bin": {
    "cockpit": "bin/cockpit"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "node --test tests/*.test.mjs && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint bin/cockpit tests/*.mjs && pnpm -r lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.68.0"
  }
}
