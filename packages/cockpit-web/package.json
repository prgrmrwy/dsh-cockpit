    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^30.0.1",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^2"
  }
}